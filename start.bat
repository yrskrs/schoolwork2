@echo off
:: ============================================================================
:: Шкільні Завдання (SchoolNet) — Головний скрипт швидкого запуску (Windows)
:: ============================================================================
:: Встановлюємо кодову сторінку UTF-8 (65001) для коректного відображення 
:: кирилиці в консолі Windows cmd.exe без спотворення символів.
chcp 65001 > nul
title Шкільні Завдання (SchoolNet) — Запуск сервера

:: ── Перехід до робочої директорії скрипта ─────────────────────────────────────
:: "%~dp0" гарантує, що скрипт працює правильно при запуску з будь-якої папки/ярлика
cd /d "%~dp0"

:: ── Крок 1. Перевірка наявності інтерпретатора Python ─────────────────────────
python --version >nul 2>&1
if errorlevel 1 (
    py --version >nul 2>&1
    if errorlevel 1 (
        echo ============================================================
        echo  [ПОМИЛКА] Python не знайдено в системі!
        echo  Будь ласка, встановіть Python 3.10+ з https://www.python.org/
        echo  Обов'язково поставте галочку "Add Python to PATH"!
        echo ============================================================
        pause
        exit /b 1
    )
    set PY_CMD=py
) else (
    set PY_CMD=python
)

:: ── Крок 2. Автоматичне створення venv та встановлення залежностей ───────────
if not exist "venv\Scripts\python.exe" (
    echo ============================================================
    echo    Шкільні Завдання (SchoolNet) — Первинне налаштування
    echo ============================================================
    echo.
    echo [1/3] Створення ізольованого віртуального середовища (venv)...
    %PY_CMD% -m venv venv
    if errorlevel 1 (
        echo [ПОМИЛКА] Не вдалося створити venv! Перевірте права доступу.
        pause
        exit /b 1
    )
    echo [OK] Віртуальне середовище створено.
    echo.

    echo [2/3] Встановлення необхідних бібліотек (Django, PyQt6, Pillow тощо)...
    venv\Scripts\python.exe -m pip install --upgrade pip --quiet
    venv\Scripts\pip.exe install -r requirements.txt
    if errorlevel 1 (
        echo [ПОМИЛКА] Не вдалося встановити бібліотеки з requirements.txt!
        pause
        exit /b 1
    )
    echo [OK] Усі бібліотеки успішно встановлено.
    echo.

    echo [3/3] Перевірка та застосування структури бази даних...
    venv\Scripts\python.exe manage.py migrate --no-input >nul 2>&1
    if errorlevel 1 (
        echo [ПОПЕРЕДЖЕННЯ] Міграції завершились з попередженням.
    ) else (
        echo [OK] База даних готова до роботи.
    )
    echo.
)

:: ── Крок 3. Запуск графічного інтерфейсу лаунчера ────────────────────────────
:: Якщо доступний pythonw.exe, запускаємо без фонового вікна консолі
if exist "venv\Scripts\pythonw.exe" (
    start "" "venv\Scripts\pythonw.exe" launcher.py
) else (
    start "" "venv\Scripts\python.exe" launcher.py
)

:: Успішне завершення роботи скрипта
exit /b 0

