# ==============================================================================
# SchoolNet — Змінні середовища (Environment Configuration)
# Скопіюйте цей файл як .env: cp .env.example .env
# ==============================================================================

# Порт веб-застосунку на хості (за замовчуванням: 8000)
APP_PORT=8000

# Секретний ключ Django (обов'язково змініть на довгий випадковий рядок для продакшну)
SECRET_KEY=schoolnet-super-secret-key-change-this-for-production-2026

# Режим налагодження (False для продакшн-сервера)
DEBUG=False

# Швидке відкриття перевірки; False повертає попередній спосіб після перезапуску.
SCHOOLNET_REVIEW_ASYNC=True
# Спільний кеш витягів, хешів та конвертацій (кількість записів).
AI_CACHE_MAX_ENTRIES=2000

# ─── Налаштування бази даних PostgreSQL ─────────────────────────────────────────
POSTGRES_DB=schoolnet_db
POSTGRES_USER=schoolnet_user
POSTGRES_PASSWORD=schoolnet_secure_password_change_me

# Рядок підключення для Django контейнера
DATABASE_URL=postgres://schoolnet_user:schoolnet_secure_password_change_me@postgres:5432/schoolnet_db

# Optional server-to-server roster integration. Generate separate long tokens.
# Browser URLs and internal API URLs differ; never put these tokens in frontend JS.
INTEGRATION_NETWORK=school-integration
ROSTER_SYNC_TOKEN=
ROSTER_PEERS=[]
ROSTER_SYNC_INTERVAL=30
# ROSTER_PEERS is a JSON array: [{"url":"http://peer-alias:8000/api/v2/roster-sync/","token":"peer-server-token"}]

# Optional fixed public browser origin. Blank uses the IP/domain and port currently opened by the teacher.
PUBLIC_BASE_URL=
# Python review runner (Docker Compose configures URL and token automatically).
# For a local Django process: CODE_RUNNER_URL=http://127.0.0.1:8002
# Use the same secret in Django and the broker; defaults to SECRET_KEY.
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=
CODE_RUNNER_MAX_SESSIONS=4
CODE_RUNNER_RUN_SECONDS=180
