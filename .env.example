# ==============================================================================
# SchoolNet — Змінні середовища (Environment Configuration)
# Скопіюйте цей файл як .env: cp .env.example .env
# ==============================================================================

# Порт веб-застосунку на хості (за замовчуванням: 8000)
APP_PORT=8000

# Секретний ключ Django (обов'язково змініть на довгий випадковий рядок для продакшну)
SECRET_KEY=schoolnet-super-secret-key-change-this-for-production-2026

# Режим налагодження (False для продакшн-сервера)
DEBUG=False

# ─── Налаштування бази даних PostgreSQL ─────────────────────────────────────────
POSTGRES_DB=schoolnet_db
POSTGRES_USER=schoolnet_user
POSTGRES_PASSWORD=schoolnet_secure_password_change_me

# Рядок підключення для Django контейнера
DATABASE_URL=postgres://schoolnet_user:schoolnet_secure_password_change_me@postgres:5432/schoolnet_db
