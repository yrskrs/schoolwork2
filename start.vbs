' Шкільні Завдання (SchoolNet) — Безконсольний запуск лаунчера (Windows VBS)
' ============================================================================
' Запускає start.bat абсолютно приховано (без миготіння чорного вікна cmd)
Set WshShell = CreateObject("WScript.Shell")
WshShell.Run "cmd.exe /c start.bat", 0, False
Set WshShell = Nothing

